# -------------------------------------------------------------------------
# .env.example - INSTITUTIONAL SECRETS TEMPLATE
# Do NOT place real credentials in this file. Copy to `.env` for DEV ONLY.
# In PRODUCTION, inject these directly into the process environment variables.
# -------------------------------------------------------------------------

# ==========================================
# 1. CORE BOT CONFIGURATION
# ==========================================
# trading_mode: "paper" | "live". Live will strictly verify no .env exists on disk.
TRADING_MODE=paper

# ==========================================
# 2. EXECUTION KEYS (The Main Bot)
# Permissions: Futures Trading, Orders, Read Positions, Read Balances.
# IP Whitelist: Server Only. DO NOT ALLOW WITHDRAWALS.
# ==========================================

EXEC_KRAKEN_API_KEY=your_kraken_exec_api_key
EXEC_KRAKEN_API_SECRET=your_kraken_exec_secret_key

# ==========================================
# 3. KILL-SWITCH & READ-ONLY KEYS (The OOB System)
# Permissions: Futures Trading, Orders, Read Positions.
# IP Whitelist: Server + VPN Admin. DO NOT ALLOW WITHDRAWALS.
# ==========================================

KILL_KRAKEN_API_KEY=your_kraken_kill_api_key
KILL_KRAKEN_API_SECRET=your_kraken_kill_secret_key

# ==========================================
# 4. BOT PARAMETER OVERRIDES
# ==========================================
SMC_STALE_THRESHOLD_MS=250
BOT_RISK_PCT=1.0
BOT_LEVERAGE=3

# ==========================================
# 5. SL/TP PROTECTION (OBLIGATOIRE)
# ==========================================
# Si le signal ne fournit pas de SL/TP, le bot en crée un automatiquement.
# En cas d'échec d'attachement SL après RISK_RETRY_COUNT tentatives,
# la position est fermée d'urgence (emergency close).
RISK_SL_PCT=1.0                # SL = 1% du prix d'entrée
RISK_TP_PCT=2.0                # TP = 2% du prix d'entrée
RISK_RETRY_COUNT=3             # Max tentatives avant emergency close

# Mode ATR (SL/TP basés sur la volatilité)
RISK_USE_ATR=false
RISK_ATR_PERIOD=14
RISK_ATR_MULT_SL=1.5
RISK_ATR_MULT_TP=2.0

# ==========================================
# 6. POSITION SAFETY GUARD
# ==========================================
# Boucle en arrière-plan vérifiant chaque position :
#   - SL/TP existent ? sinon → recréation avec retry
#   - Drawdown > seuil ? → réduction automatique
#   - Trailing stop activé ? → ajustement SL
RISK_GUARD_ENABLED=true
RISK_GUARD_INTERVAL_SEC=30
RISK_MAX_ADVERSE_MOVE_PCT=1.0
RISK_REDUCE_STEP_PCT=25
RISK_TRAILING_ENABLED=false
RISK_TRAILING_ACTIVATE_AT_PCT=0.8
RISK_TRAILING_DISTANCE_PCT=0.4

# ==========================================
# 7. DECISION ENGINE (gestion autonome)
# ==========================================
# Évalue chaque position et décide : HOLD / REDUCE / CLOSE / TIGHTEN
DECISION_ENGINE_ENABLED=true
DECISION_ENGINE_INTERVAL_SEC=15
RISK_ATR_SPIKE_MULT=2.0
DECISION_MAX_POSITION_AGE_HOURS=48

# ==========================================
# 8. MULTI-BROKER: KRAKEN FUTURES (PRIMARY)
# ==========================================
DEFAULT_BROKER=kraken
BITGET_ENABLED=false
KRAKEN_ENABLED=true
KRAKEN_EXECUTION_ENABLED=true
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret
KRAKEN_SYMBOLS=PF_XBTUSD,PF_ETHUSD,PF_SOLUSD
KRAKEN_MAX_TRADE_RISK_USD=4.50
KRAKEN_TAKER_FEE_BPS=5.0
KRAKEN_RISK_SLIPPAGE_BPS=5.0

# Risk Engine V2 sizing limits
RISK_PCT=0.03
RISK_V2_MAX_POSITION_PCT=100.0
RISK_V2_MAX_GLOBAL_EXPOSURE_PCT=200.0

# ==========================================
# 9. METATRADER 5 (MT5) — CRYPTO & FOREX SMC
# ==========================================
MT5_ENABLED=true
MT5_EXECUTION_ENABLED=true
MT5_ALLOW_LIVE=false
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,EURUSD,GBPUSD,USDJPY,XAUUSD
MT5_FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MT5_MAX_LOT_SIZE=0.01
MT5_MAX_OPEN_PER_SYMBOL=1
MT5_MAGIC_NUMBER=20261122
MT5_DEVIATION_POINTS=30
MT5_FOREX_FRIDAY_CLOSE_UTC_HOUR=20
MT5_FOREX_FRIDAY_CLOSE_UTC_MIN=30
MT5_FOREX_CLOSE_DAILY_ROLLOVER=true
